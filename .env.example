# Restic Backup System Configuration
# Copy this file to .env and fill in your values

# Restic repository location
RESTIC_REPOSITORY=/path/to/restic/repo
RESTIC_PASSWORD_FILE=$HOME/.config/restic/password

# Google Drive offsite sync (rclone remote)
GDRIVE_DEST=gdrive:Backups/restic

# Discord webhook for notifications
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Bot identity for Discord messages
BOT_USERNAME="Backup Bot"
BOT_AVATAR_URL=

# Docker Compose directory (where docker-compose.yml lives)
DOCKER_DIR=/path/to/docker-compose-directory
COMPOSE_PROJECT_NAME=myproject

# Plex volume name (for targeted Plex DB backup)
PLEX_VOLUME=${COMPOSE_PROJECT_NAME}_plex_config

# Home directory to backup
BACKUP_HOME_DIR=$HOME

# Log directory
LOG_DIR=/var/log/backup-system
